# Shiori Slice 01 configuration.
# Copy to .env.local, replace every <...> placeholder, and never commit that file.
# Each assignment below is a safe sample; comments say where to get the real value.

# Telegram
# Bot API credential. Create the bot with Telegram @BotFather and copy its token.
TELEGRAM_BOT_TOKEN=<telegram-bot-token>
# Random token Telegram echoes in the X-Telegram-Bot-Api-Secret-Token header.
# Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=<random-webhook-secret>
# Numeric ID of the only authorized owner. Read message.from.id from getUpdates.
TELEGRAM_OWNER_USER_ID=<numeric-telegram-user-id>

# OpenAI Responses API
# Server-side project key. Create one in the OpenAI API dashboard.
OPENAI_API_KEY=<openai-api-key>
# Pinned DecisionEngine model; change only through an auditable config update.
OPENAI_MODEL=gpt-5.6-terra
# Application-owned prompt/schema version written to model-decision audit records.
OPENAI_PROMPT_VERSION=shiori-s01-v1
# Durable encrypted conversation retention in seconds (1 hour to 30 days).
# Sample: 2592000 keeps sessions for 30 days; omitted uses the same default.
AGENT_SESSION_RETENTION_SECONDS=2592000

# Supabase
# HTTP API URL, never a postgresql:// URL. Local: API URL from `supabase status`.
# Hosted sample: https://your-project-ref.supabase.co
SUPABASE_URL=http://127.0.0.1:54321
# Privileged Fastify-only credential paired with SUPABASE_URL.
# Local: service_role key from `supabase status`; hosted: Settings > API Keys >
# Secret keys (sb_secret_...). Never use a DB password, publishable key, or anon key.
SUPABASE_SECRET_KEY=<local-service_role-JWT-or-hosted-sb_secret-key>
# Release-verifier-only hosted Postgres pooler URL. Percent-encode credentials.
# This is passed directly to the Supabase CLI and is never printed or retained.
SUPABASE_DATABASE_POOLER_URL=<percent-encoded-hosted-pooler-url>

# Google OAuth
# OAuth Web Application client ID from Google Cloud Console > Credentials.
GOOGLE_OAUTH_CLIENT_ID=<google-web-application-client-id>
# Secret belonging to the same Google OAuth Web Application client.
GOOGLE_OAUTH_CLIENT_SECRET=<google-web-application-client-secret>
# Exact Google account email allowed to complete the owner OAuth flow.
GOOGLE_OWNER_EMAIL=<owner-google-account@example.com>
# Random 32-byte key used to encrypt the saved refresh token with AES-256-GCM.
# Generate: openssl rand -base64 32
GOOGLE_TOKEN_ENCRYPTION_KEY=<base64-encoded-32-byte-key>
# Integer version stored beside encrypted tokens to support explicit key rotation.
GOOGLE_TOKEN_KEY_VERSION=1

# Owner dashboard
# Argon2id PHC string used to verify login; never put the plaintext password here.
# Generate interactively with Node 24.7+:
# read -s "SHIORI_PASSWORD?Dashboard password: "; echo
# SHIORI_PASSWORD="$SHIORI_PASSWORD" node --input-type=module -e 'import{argon2Sync,randomBytes}from"node:crypto";const s=randomBytes(16),b=x=>x.toString("base64").replace(/=+$/,""),h=argon2Sync("argon2id",{message:process.env.SHIORI_PASSWORD,nonce:s,parallelism:1,tagLength:32,memory:65536,passes:3});console.log(`$argon2id$v=19$m=65536,t=3,p=1$${b(s)}$${b(h)}`)'
# unset SHIORI_PASSWORD
DASHBOARD_PASSWORD_HASH=<argon2id-password-hash>
# Independent random key that signs the short-lived owner session cookie.
# Generate: openssl rand -base64 32
DASHBOARD_SESSION_SECRET=<base64-encoded-random-32-byte-secret>

# Fixed slice configuration
# IANA time zone used for owner-entered times and scheduling. Sample: Asia/Singapore.
OWNER_TIME_ZONE=Asia/Singapore
# Public origin of this running instance; no trailing slash.
# Local sample: http://localhost:3000
# Railway sample: https://shiori-slice-01-production.up.railway.app
PUBLIC_APP_BASE_URL=http://localhost:3000

# Release-verifier-only immutable Railway identity. The application receives
# these automatically on Railway; the verifier refuses every other target.
RAILWAY_PROJECT_ID=d8806797-6bb9-495b-8e10-b13122a6eff6
RAILWAY_ENVIRONMENT_ID=0a533591-3fce-4904-8fb3-84d0f52346e7
RAILWAY_SERVICE_ID=85bc7677-b070-43ce-8ae1-e2c65241a721

# Google redirect URI derived from the value above:
#   ${PUBLIC_APP_BASE_URL}/api/google-calendar/callback

# Google OAuth scopes are security policy, not environment configuration.
# The application must request exactly:
#   openid
#   email
#   https://www.googleapis.com/auth/calendar.events.readonly
#   https://www.googleapis.com/auth/calendar.freebusy
#
# Authorized redirect URIs for the current project:
#   http://localhost:3000/api/google-calendar/callback
#   https://shiori-slice-01-production.up.railway.app/api/google-calendar/callback

# Not application configuration:
# - DEPLOYED_APP_BASE_URL duplicates PUBLIC_APP_BASE_URL and is not read.
# - TELEGRAM_OWNER_ID duplicates TELEGRAM_OWNER_USER_ID and is not read.
# - SUPABASE_PUBLISHABLE_KEY is not needed by the server-side Supabase client.
# - SUPABASE_DATABASE_POOLER_URL and the Railway IDs are release-verifier-only;
#   they are not application runtime configuration.

# Optional. When true, a fail-closed conversation reply carries its reason code,
# for example "... [decision_clarification_context_mutation]", so an owner
# screenshot identifies the failing path without correlating timestamps against
# public.conversation_turn_failures. Default false. Temporary diagnostic aid.
CONVERSATION_FAILURE_CODES=false

# Optional. Reasoning effort for the conversation agent: none, minimal, low,
# medium (default) or high. Shiori resolves relative Singapore dates and decides
# which draft fields changed, so deliberation helps; lower it to trade accuracy
# for latency and cost.
OPENAI_REASONING_EFFORT=medium

# Langfuse keys
LANGFUSE_SECRET_KEY=sk-lf-key
LANGFUSE_PUBLIC_KEY=pk-lf-key
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

