{
  "name": "@shiori/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx --env-file-if-exists=../.env.local watch src/index.ts",
    "seed:dashboard:qa:local": "tsx --env-file-if-exists=../.env.local test/seed-dashboard-qa.ts",
    "smoke:openai": "tsx --env-file-if-exists=../.env.local test/openai-decision.smoke.ts",
    "start": "node --env-file-if-exists=../.env.local dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:langfuse": "tsx --env-file-if-exists=../.env.local test/langfuse-tracing.smoke.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@langfuse/client": "^5.9.1",
    "@langfuse/otel": "^5.9.1",
    "@langfuse/tracing": "^5.9.1",
    "@openai/agents": "^0.14.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "fastify": "^5.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
